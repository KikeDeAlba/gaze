{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [{ "type": "command", "command": "gaze hook session-start", "timeout": 5 }]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{ "type": "command", "command": "gaze hook prompt", "timeout": 3 }]
      }
    ],
    "PreCompact": [
      {
        "hooks": [{ "type": "command", "command": "gaze hook harvest", "timeout": 5 }]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [{ "type": "command", "command": "gaze hook harvest", "timeout": 5 }]
      }
    ]
  }
}
