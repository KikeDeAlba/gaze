{
  "name": "@kikedealba/gaze-win32",
  "version": "0.7.0",
  "description": "gaze en Windows: port en JavaScript sobre node.exe, sin binarios nativos",
  "license": "MIT",
  "author": "Jesus Enrique De Alba Gaytan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KikeDeAlba/gaze.git",
    "directory": "packages/gaze-win32"
  },
  "type": "module",
  "os": [
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "engines": {
    "node": ">=24.5"
  },
  "exports": {
    ".": "./src/index.js",
    "./bin": "./bin/gaze.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "onnxruntime-web": "1.30.0",
    "@huggingface/tokenizers": "0.2.0",
    "smol-toml": "1.9.1"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\""
  },
  "publishConfig": {
    "access": "public"
  }
}
